{
  "name": "autofill-resume-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build:extension": "node scripts/build-extension.mjs",
    "zip:extension": "./scripts/package-extension.sh",
    "build": "npm run clean && npm run build:extension && npm run zip:extension",
    "check": "npm run clean && npm run build:extension",
    "verify:zip": "./scripts/verify-zip-manifest-root.sh dist/extension.zip"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.302",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
